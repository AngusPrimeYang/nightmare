# Copy this file to ue.local.env on each machine and adjust paths.
# Priority: process environment variables > ue.local.env values.
#
#   copy ue.local.env.example ue.local.env

# Absolute path to the Unreal Engine root (folder that contains Engine/)
UE_ROOT=C:\Program Files\Epic Games\UE_5.5

# Project name without .uproject extension (must match *.uproject / module name)
UE_PROJECT=Nightmare

# UBT build target / platform / configuration
UE_TARGET=NightmareEditor
UE_PLATFORM=Win64
UE_CONFIG=Development
